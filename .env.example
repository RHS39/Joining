# Build-time configuration for the Kores Records SPA.
#
# Copy this file to `.env.production` and adjust the values before building.
# `.env*` files are git-ignored, so each environment keeps its own settings.

# Public base path of the deployed application.
#   "/"            -> https://example.com/            (root domain, Vercel, Netlify)
#   "/my-repo/"    -> https://user.github.io/my-repo/  (GitHub Pages project site)
BASE_PATH=/

# The application has no runtime environment variables: everything happens in
# the browser, no server, no API keys, no tracking.
#
# The cloud reader of the passbook photo is the one optional exception. It is
# a small serverless function that sends the photo to the Gemini API and gets
# the bank details back. It is off unless the key below is set.

# The key of the Gemini API, created in https://aistudio.google.com/apikey.
# This is a *server* variable: the name must not start with VITE_, otherwise
# the key would end up in the browser bundle.
# GEMINI_API_KEY=your-key-here

# The model that reads the photo. Gemini 3.8 Flash is free of charge on the
# free tier of the Gemini API.
# GEMINI_MODEL=gemini-3.8-flash

# The address of the function, when it does not run on the same address as
# the application. This is a *client* variable, so it has to start with
# VITE_. Without it the application looks for /api/ocr.
# VITE_OCR_PROXY_URL=https://ocr.example.com/api/ocr
